# ---------- Groq (STT + LLM) ----------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_STT_MODEL=whisper-large-v3
# NOTE: llama-3.1-8b-instant (the successor of Llama-3-8B) was deprecated by Groq on 2026-08-16.
# Default below is Groq's recommended replacement. Verify live IDs: GET https://api.groq.com/openai/v1/models
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Only valid for gpt-oss reasoning models. LEAVE EMPTY if you switch to a Llama/Qwen model without reasoning_effort support.
GROQ_REASONING_EFFORT=low

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # service_role key (server-side only, NEVER ship to client)

# ---------- Upstash Redis (REST) ----------
UPSTASH_REDIS_REST_URL=https://xxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXxxxxxxxxxxxxxxxx

# ---------- TTS ----------
TTS_PROVIDER=gtts            # gtts | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------- Tunables (optional) ----------
TIMEZONE=Asia/Kolkata
VAD_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.45
DB_SIMILARITY_THRESHOLD=0.20
